{
  "name": "@anushibinj/fetch-mcp",
  "version": "1.0.0",
  "description": "MCP server for making HTTP requests via the built-in fetch API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fetch-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport=http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport=http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
